# Strapi content API, without the /api suffix.
STRAPI_URL=http://localhost:1337

# Admin panel -> Settings -> API Tokens. All three stay on the server.
STRAPI_READ_TOKEN=
STRAPI_DRAFT_TOKEN=
STRAPI_INQUIRY_TOKEN=

# Must match apps/cms/.env.
REVALIDATE_SECRET=
PREVIEW_SECRET=

# The only origin allowed to frame the web app (Strapi's admin preview).
CMS_ORIGIN=http://localhost:1337

# Public base URL of the media bucket.
S3_PUBLIC_URL=http://127.0.0.1:9000/eaves-media

# Cloudflare Turnstile test keys. Replace with the real pair in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
