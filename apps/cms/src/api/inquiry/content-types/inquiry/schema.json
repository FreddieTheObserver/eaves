{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "email": {
      "type": "email",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "new_project",
        "press",
        "other"
      ],
      "required": true
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 5000
    },
    "consent": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
