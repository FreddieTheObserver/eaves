{
  "name": "eaves",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:web": "pnpm --filter @eaves/web dev",
    "dev:cms": "pnpm --filter @eaves/cms develop",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check:schema": "pnpm --filter @eaves/cms check:schema",
    "check:access": "pnpm --filter @eaves/cms check:access",
    "check:publish": "pnpm --filter @eaves/cms check:publish",
    "record:fixtures": "pnpm --filter @eaves/cms record:fixtures",
    "storage:init": "pnpm --filter @eaves/cms storage:init",
    "test": "pnpm --recursive --if-present run test",
    "docker:up": "docker compose up -d && pnpm storage:init",
    "docker:down": "docker compose down"
  },
  "packageManager": "pnpm@10.33.0"
}
